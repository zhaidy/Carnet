rules_version = '2';

// Carnet 自己的 Firebase 项目：贴到 Firebase 控制台 → Firestore Database → 规则
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBookMember(code) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/books/$(code)).data.members;
    }

    match /books/{code} {
      // 只有成员能看账本；不能列出所有账本
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      // 新建时成员只有自己
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'name', 'currency', 'percent', 'settleMode', 'settleDay', 'settleEpochDay'])
        && request.resource.data.members == [request.auth.uid];
      // 知道邀请码的人只能把自己加进 members
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() <= resource.data.members.size() + 1
        && request.resource.data.members.size() <= 10
        && request.auth.uid in request.resource.data.members;

      // 共用的账和两清记录：成员可读写（账户信息不上传）
      match /{document=**} {
        allow read, write: if isBookMember(code);
      }
    }
  }
}
